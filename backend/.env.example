APP_NAME="LLC-Event"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The Vue app's address; used in registration links.
FRONTEND_URL=http://localhost:5173
# Staff setup invitations use email. Keep "log" for local development; use
# "smtp" (and configure the values below) in deployments that must deliver mail.
MAIL_MAILER=log
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"
# Registration dates are calendar days in this time zone.
BUSINESS_TIMEZONE=Asia/Phnom_Penh
# Comma-separated origins allowed to call the API. Set this to the Vue app's address in production.
CORS_ALLOWED_ORIGINS=*

# Required by `php artisan db:seed` when APP_ENV=production; leave empty otherwise.
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=event_registration
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
